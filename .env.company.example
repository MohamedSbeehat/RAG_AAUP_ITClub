# Each company signs in to an isolated private workspace.
MULTI_TENANT_ENABLED=true
WORKSPACE_ROOT=workspaces
SESSION_HOURS=12
KNOWLEDGE_MODE=organization
ORGANIZATION_NAME=Company
ASSISTANT_NAME="مساعد ملفات الشركة"
RAW_DIR=documents
DATABASE_PATH=indexes/company.sqlite3
QDRANT_COLLECTION=company_chunks
# QDRANT_PATH=indexes/company.qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=40
OLLAMA_MODEL=qwen2.5:3b
REFRESH_INTERVAL_SECONDS=15
REMOVE_DELETED_DOCUMENTS=true
MAX_UPLOAD_SIZE_MB=25
MINIMUM_DENSE_SCORE=0.28
RETRIEVAL_LIMIT=6
RETRIEVAL_CANDIDATE_LIMIT=64
# APP_PASSWORD applies only to legacy single-workspace mode. Use HTTPS in production.
APP_USERNAME=admin
APP_PASSWORD=
