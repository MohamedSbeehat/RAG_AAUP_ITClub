# Copy this file to .env. Keep real API keys out of Git.
RAW_DIR=data/raw
DATABASE_PATH=indexes/rag.sqlite3
# Qdrant local storage defaults to DATABASE_PATH with the .qdrant suffix.
# QDRANT_PATH=indexes/rag.qdrant
# Set a URL to use a Qdrant server instead of local storage.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=academic_chunks
QDRANT_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=auto

# Optional Gemini API key (use a free-tier key; quotas and terms can change).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Free local fallback. Install Ollama and pull this model to use it.
OLLAMA_MODEL=qwen2.5:3b
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=40
REFRESH_INTERVAL_SECONDS=15
MINIMUM_DENSE_SCORE=0.28
RETRIEVAL_LIMIT=6
RETRIEVAL_CANDIDATE_LIMIT=64
KNOWLEDGE_MODE=academic
ORGANIZATION_NAME=AAUP
ASSISTANT_NAME="مساعد المستندات"
REMOVE_DELETED_DOCUMENTS=true
MAX_UPLOAD_SIZE_MB=25
APP_USERNAME=admin
APP_PASSWORD=
