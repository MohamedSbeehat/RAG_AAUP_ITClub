# Company registration and sign-in; files and chat history are isolated per company.
MULTI_TENANT_ENABLED=true
WORKSPACE_ROOT=workspaces
SESSION_HOURS=12
KNOWLEDGE_MODE=organization
ORGANIZATION_NAME=CampusIQ
ASSISTANT_NAME=CampusIQ
RAW_DIR=documents
DATABASE_PATH=indexes/company.sqlite3
QDRANT_COLLECTION=organization_chunks
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=auto
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=40
REFRESH_INTERVAL_SECONDS=15
REMOVE_DELETED_DOCUMENTS=true
MAX_UPLOAD_SIZE_MB=25
RETRIEVAL_LIMIT=6
RETRIEVAL_CANDIDATE_LIMIT=64
